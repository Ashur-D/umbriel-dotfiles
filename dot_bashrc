# If not running interactively, don't do anything (leave this at the top of this file)
[[ $- != *i* ]] && return

###------------------- Editor used by CLI -----------------------###
export EDITOR="nvim"
export SUDO_EDITOR="nvim"

###------------------- starship -----------------------###
eval "$(starship init bash)"

###------------------- aliases -----------------------###
alias f="fastfetch"
alias ga='git add .'
alias gp='git push'
alias gpp='git pull'
alias gcm='git commit -m "updated"'

function gc() {
    local msg="$*"
    if [ -z "$msg" ]; then
        read -r -e -p "Enter commit message: " msg
    fi

    if [ -n "$msg" ]; then
        git commit -m "$msg"
    else
        echo "Commit aborted."
    fi
}

###------------------- umbriel auto start -----------------------###
alias umbriel='start-umbriel'

if [ "$(tty)" = "/dev/tty1" ]; then
  exec start-umbriel
fi

###------------------- shell wrapper -----------------------###
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

