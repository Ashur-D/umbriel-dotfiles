# If not running interactively, don't do anything (leave this at the top of this file)
[[ $- != *i* ]] && return

###------------------- Editor used by CLI -----------------------###
export EDITOR="nvim"
export SUDO_EDITOR="nvim"

###------------------- starship -----------------------###
eval "$(starship init bash)"

###------------------- aliases -----------------------###
alias f="fastfetch"
alias ga='git add .'
alias gp='git push'
alias gpp='git pull'

function gc() {
    # Print a styled prompt: bold magenta prompt symbol and dim hint
    printf "\033[1;35m? \033[1;37mCommit message\033[0m \033[2m(Esc/Enter with no text to abort)\033[0m: "
    read -r -e MESSAGE

    if [ -n "$MESSAGE" ]; then
        git commit -m "$MESSAGE"
    else
        printf "\033[33mCommit aborted.\033[0m\n"
    fi
}

###------------------- umbriel auto start -----------------------###
alias umbriel='start-umbriel'

if [ "$(tty)" = "/dev/tty1" ]; then
  exec start-umbriel
fi

###------------------- shell wrapper -----------------------###
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

