{{- /* Rendered by `chezmoi init`. Answers are remembered in ~/.config/chezmoi/chezmoi.toml. */ -}}

{{- /* Detect an NVIDIA GPU once; templates and scripts branch on .hasNvidia. */ -}}
{{- $hasNvidia := false -}}
{{- if lookPath "lspci" -}}
{{-   $gpu := output "sh" "-c" "lspci 2>/dev/null | grep -Ei 'vga|3d' | grep -i nvidia || true" -}}
{{-   $hasNvidia = contains "nvidia" (lower $gpu) -}}
{{- end -}}

{{- /* Which modules (see .chezmoidata/modules.toml) to enable besides `core`. */ -}}
{{- $selection := promptStringOnce . "moduleSelection" "Modules to enable (nvim,yazi,zed,fastfetch,cli,dev,desktop,gaming,system,media,rice)" "nvim,yazi,zed,fastfetch,cli,dev" -}}
{{- /* .chezmoidata is not exposed to this template, so read the file directly. */ -}}
{{- $known := (include ".chezmoidata/modules.toml" | fromToml).modules -}}
{{- $enabled := list -}}
{{- range splitList "," $selection -}}
{{-   $name := trim . -}}
{{-   if $name -}}
{{-     if not (hasKey $known $name) -}}
{{-       fail (printf "unknown module %q (see .chezmoidata/modules.toml)" $name) -}}
{{-     end -}}
{{-     $enabled = append $enabled $name -}}
{{-   end -}}
{{- end -}}

{{- /* .chezmoi.sourceDir already includes the `home` root, so keep its parent. */ -}}
sourceDir = {{ dir .chezmoi.sourceDir | quote }}

[data]
    hasNvidia = {{ $hasNvidia }}
    moduleSelection = {{ $selection | quote }}
    enabled = {{ $enabled | toJson }}
