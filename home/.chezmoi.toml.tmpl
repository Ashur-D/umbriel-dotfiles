{{- /* Rendered by `chezmoi init`. Answers are remembered in ~/.config/chezmoi/chezmoi.toml. */ -}}

{{- /* Detect an NVIDIA GPU once; templates and scripts branch on .hasNvidia. */ -}}
{{- $hasNvidia := false -}}
{{- if lookPath "lspci" -}}
{{-   $gpu := output "sh" "-c" "lspci 2>/dev/null | grep -Ei 'vga|3d' | grep -i nvidia || true" -}}
{{-   $hasNvidia = contains "nvidia" (lower $gpu) -}}
{{- end -}}

{{- /* Which modules to enable besides `core`. Auto-discovered from modules.toml. */ -}}
{{- $known := without ((include ".chezmoidata/modules.toml" | fromToml).modules | keys | sortAlpha) "core" -}}
{{- $enabled := promptMultichoiceOnce . "enabled" "Optional modules to enable" $known -}}
{{- /* .chezmoi.sourceDir already includes the `home` root, so keep its parent. */ -}}
sourceDir = {{ dir .chezmoi.sourceDir | quote }}

[diff]
    exclude = ["scripts"]

[data]
    hasNvidia = {{ $hasNvidia }}
    enabled = {{ $enabled | toJson }}
