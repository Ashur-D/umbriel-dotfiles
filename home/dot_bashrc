alias start='start-umbriel'

###------------------- noctalia export helper -----------------------###
noctalia-export() {
    local default_dest
    if command -v chezmoi &>/dev/null; then
        local src="$(chezmoi source-path 2>/dev/null)"
        if [ -n "$src" ] && [ -d "$src/dot_config/noctalia" ]; then
            default_dest="$src/dot_config/noctalia/config.toml"
        fi
    fi
    default_dest="${default_dest:-$HOME/umbriel-dotfiles/home/dot_config/noctalia/config.toml}"

    local dest="${1:-}"
    if [ -z "$dest" ]; then
        read -r -e -p "Export Noctalia config to [$default_dest]: " dest
    fi
    dest="${dest:-$default_dest}"
    dest="${dest/#\~/$HOME}"

    mkdir -p "$(dirname "$dest")"
    if noctalia config export merged > "$dest"; then
        echo ":: Noctalia config exported successfully to $dest"
    else
        echo ":: Error: Failed to export Noctalia config" >&2
        return 1
    fi
}
alias nexport='noctalia-export'

noctalia-toggle() {
    local cfg="$HOME/.config/noctalia/config.toml"
    local custom="$HOME/.config/noctalia/config.toml.custom"

    if [ -f "$cfg" ]; then
        mv "$cfg" "$custom"
        echo ":: Switched to Noctalia Absolute Factory Defaults"
    elif [ -f "$custom" ]; then
        mv "$custom" "$cfg"
        echo ":: Switched to your Custom Rice"
    else
        echo ":: Error: Neither config.toml nor config.toml.custom found in ~/.config/noctalia/" >&2
        return 1
    fi
    noctalia msg config-reload 2>/dev/null || true
}
alias ntoggle='noctalia-toggle'
###------------------- shell wrapper -----------------------###
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd <"$tmp"
    [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
}

###------------------- pi helper -----------------------###
pi() {
    if [ "$PWD" = "$HOME" ]; then
        (mkdir -p "$HOME/Projects/PiProjects" && cd "$HOME/Projects/PiProjects" && command pi "$@")
    else
        command pi "$@"
    fi
}
alias piq='pi --no-session'

export PATH="$HOME/.local/bin:$PATH"
