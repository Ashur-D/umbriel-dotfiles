#!/bin/bash
# Services and launcher cleanup. Idempotent; re-runs when the module
# services or `hidden_apps` in .chezmoidata/modules.toml change.
set -euo pipefail

warn() { echo ":: WARNING: $*" >&2; }

xdg-user-dirs-update

# NetworkManager conflicts with iwd / systemd-networkd. Never switch a running
# network stack automatically: it could cut the connection mid-run.
conflict=
for svc in iwd.service systemd-networkd.service; do
    if systemctl is-enabled "$svc" >/dev/null 2>&1; then conflict=$svc; fi
done
if [ -n "$conflict" ]; then
    warn "$conflict is enabled and conflicts with NetworkManager; skipping NetworkManager."
    warn "To switch: sudo systemctl disable --now iwd systemd-networkd && sudo systemctl enable --now NetworkManager"
fi

# --- Services (failures are reported, not hidden) ---------------------------
enable() {
    for svc in "$@"; do
        if [ "$svc" = NetworkManager.service ] && [ -n "$conflict" ]; then continue; fi
        sudo systemctl enable --now "$svc" || warn "failed to enable $svc"
    done
}
{{- range (concat (list "core") .enabled | uniq) }}
{{-   if hasKey $.modules . }}
{{-     $m := index $.modules . }}
{{-     if hasKey $m "services" }}
enable{{ range $m.services }} {{ . | quote }}{{ end }}
{{-     end }}
{{-   end }}
{{- end }}


# --- Hide utility apps from the launcher ------------------------------------
# A minimal per-user override with Hidden=true. (Copying the system file and
# appending NoDisplay=true could land inside a [Desktop Action] group and do nothing.)
mkdir -p "$HOME/.local/share/applications"
for app in {{ range .launcher.hidden_apps }}{{ . | quote }} {{ end }}; do
    [ -f "/usr/share/applications/$app.desktop" ] || continue
    printf '[Desktop Entry]\nType=Application\nName=%s\nHidden=true\n' "$app" \
        > "$HOME/.local/share/applications/$app.desktop"
done
