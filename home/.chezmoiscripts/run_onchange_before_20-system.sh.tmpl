#!/bin/bash
# Services, networking and launcher cleanup. Idempotent; re-runs when
# `hidden_apps` in .chezmoidata/packages.toml changes.
set -euo pipefail

warn() { echo ":: WARNING: $*" >&2; }

xdg-user-dirs-update

# --- Services (failures are reported, not hidden) ---------------------------
enable() {
    for svc in "$@"; do
        sudo systemctl enable --now "$svc" || warn "failed to enable $svc"
    done
}
enable bluetooth.service power-profiles-daemon.service

# --- Networking: iwd + systemd-networkd, unless NetworkManager is present ---
if systemctl is-enabled NetworkManager >/dev/null 2>&1 || command -v nmcli >/dev/null 2>&1; then
    echo ":: NetworkManager detected; skipping iwd/systemd-networkd."
else
    write_once() { [ -e "$1" ] || sudo tee "$1" >/dev/null; }
    sudo mkdir -p /etc/systemd/network

    # networkd needs .network files, otherwise no interface gets an address.
    write_once /etc/systemd/network/20-wired.network <<'EOF'
[Match]
Name=en*

[Network]
DHCP=yes

[DHCPv4]
RouteMetric=100
EOF
    write_once /etc/systemd/network/25-wireless.network <<'EOF'
[Match]
Name=wl*

[Network]
DHCP=yes
IgnoreCarrierLoss=3s

[DHCPv4]
RouteMetric=600
EOF
    if [ "$(readlink /etc/resolv.conf || true)" != /run/systemd/resolve/stub-resolv.conf ]; then
        sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
    fi
    enable iwd.service systemd-networkd.service systemd-resolved.service
fi

# --- Hide utility apps from the launcher ------------------------------------
# A minimal per-user override with Hidden=true. (Copying the system file and
# appending NoDisplay=true could land inside a [Desktop Action] group and do nothing.)
mkdir -p "$HOME/.local/share/applications"
for app in {{ range .hidden_apps }}{{ . | quote }} {{ end }}; do
    [ -f "/usr/share/applications/$app.desktop" ] || continue
    printf '[Desktop Entry]\nType=Application\nName=%s\nHidden=true\n' "$app" \
        > "$HOME/.local/share/applications/$app.desktop"
done
