#!/bin/bash
# Installs yay (if missing) and the packages of every enabled module.
# Re-runs only when the rendered list changes: edit .chezmoidata/modules.toml.
set -euo pipefail

if ! command -v yay >/dev/null 2>&1; then
    echo ":: Installing yay from AUR..."
    sudo pacman -S --needed --noconfirm git base-devel
    tmp=$(mktemp -d)
    git clone https://aur.archlinux.org/yay.git "$tmp/yay"
    # Build as the user, install with one sudo prompt (yay-[0-9]* skips yay-debug).
    (cd "$tmp/yay" && makepkg -s --noconfirm && sudo pacman -U --noconfirm yay-[0-9]*.pkg.tar.zst)
    rm -rf "$tmp"
fi

PKGS=(
{{- range (concat (list "core") .enabled | uniq) }}
{{-   if hasKey $.modules . }}
{{-     $m := index $.modules . }}
    # {{ . }}
{{-     if hasKey $m "packages" }}
{{-       range $m.packages }}
    {{ . | quote }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
{{- if .hasNvidia }}
    # nvidia
{{-   range .nvidia.packages }}
    {{ . | quote }}
{{-   end }}
{{- end }}
)
{{ if .hasNvidia }}
# Headers for every installed kernel (linux, linux-lts, linux-zen, ...).
for f in /usr/lib/modules/*/pkgbase; do
    if [ -f "$f" ]; then PKGS+=("$(<"$f")-headers"); fi
done
# 32-bit driver only if [multilib] is enabled.
if grep -q '^\[multilib\]' /etc/pacman.conf; then
    PKGS+=({{ range .nvidia.multilib_packages }}{{ . | quote }} {{ end }})
fi
{{ end }}
yay -S --needed --noconfirm --mflags="--nocheck" "${PKGS[@]}"
